#!/usr/bin/env php
<?php
use DuckPhp\DuckPhp;
use DuckPhp\Ext\DuckPhpInstaller;

require __DIR__ . '/../src/Core/AutoLoader.php';
spl_autoload_register([\DuckPhp\Core\AutoLoader::class ,'DuckPhpSystemAutoLoader']);

////////////////////////////////////////

$options=[
    'is_debug'=>true,
    'path'=>__DIR__,
    'ext' => [
        DuckPhpInstaller::class  => true,
    ],
];
DuckPhp::RunQuickly($options);