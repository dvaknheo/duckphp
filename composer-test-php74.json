{
    "name": "dvaknheo/duckphp",
    "description": "A Framework in 2018",
    "type": "library",
    "keywords": [
        "framework",
        "service"
    ],
    "homepage": "https://www.github.com/dvaknheo/duckphp",
    "license": "MIT",
    "authors": [
        {
            "name": "davknheo",
            "email": "davknheo@qq.com"
        }
    ],
	"version": "1.4.1",
    "autoload": {
        "psr-4": {
            "DuckPhp\\": "src"
        }
    },
    "require": {
        "php": ">=7.4.0"
    },
    "require-dev": {
        "dvaknheo/libcoverage": "^1.0.8",
        "phpunit/phpunit": "^9.6.36",
        "friendsofphp/php-cs-fixer": "^2.18.6",
        "phpstan/phpstan": "^0.12.35"
    },
    "bin": [
        "bin/duckphp"
    ],
    "post-install-cmd": [
        "echo 'Welcome to use DuckPHP ,run bin/duckphp form more.'"
    ]
}
